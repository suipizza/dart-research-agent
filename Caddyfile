# 리버스 프록시: 한 주소에서 화면(/)과 API(/api)를 함께 제공한다.
#
# SITE_ADDRESS 가 없으면 :80 (HTTP). 도메인을 연결했다면 SITE_ADDRESS=example.com 으로 두면
# Caddy가 Let's Encrypt 인증서를 자동으로 받아 HTTPS로 서비스한다.
{$SITE_ADDRESS::80} {
	# /api/ask → api:8000/ask (접두어를 떼고 넘긴다)
	handle_path /api/* {
		reverse_proxy api:8000 {
			# SSE(진행 단계)를 모아 두지 않고 바로 흘려보낸다
			flush_interval -1
		}
	}

	handle {
		encode gzip
		reverse_proxy web:3000
	}
}
