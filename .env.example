# Copy to .env and fill in real values. .env is git-ignored.
DART_API_KEY=your_dart_api_key_here

# Local Postgres (docker-compose defaults; change only if you need to)
POSTGRES_USER=dart
POSTGRES_PASSWORD=dart
POSTGRES_DB=dart
DATABASE_URL=postgresql+psycopg://dart:dart@localhost:5432/dart

# LLM (Claude API, console.anthropic.com에서 발급 — Pro 구독과 별개)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Langfuse (LLM 호출 추적·관측, cloud.langfuse.com 무료 플랜)
# 프로젝트 Settings → API Keys에서 발급. 키가 없으면 추적 없이 그대로 동작한다.
LANGFUSE_PUBLIC_KEY=pk-lf-your_public_key_here
LANGFUSE_SECRET_KEY=sk-lf-your_secret_key_here
LANGFUSE_HOST=https://cloud.langfuse.com
